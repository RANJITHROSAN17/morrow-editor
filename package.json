{
  "name": "wrytrove-editor",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "A small, local-first text and code editor for Windows.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark": "vitest bench scripts/performance-baseline.bench.ts",
    "benchmark:json": "vitest bench scripts/performance-baseline.bench.ts --run --reporter=json --outputFile=benchmark-results.json",
    "benchmark:table": "node scripts/benchmark-table.mjs benchmark-results.json",
    "benchmark:engines": "npm --prefix benchmarks/engines run build && node benchmarks/engines/run.mjs",
    "benchmark:products": "node benchmarks/product/run.mjs",
    "benchmark:compare": "node benchmarks/compare.mjs",
    "audit:static": "node scripts/security-audit.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.40.0",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "@tauri-apps/plugin-http": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "diff": "^9.0.0",
    "markdown-it": "^14.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
