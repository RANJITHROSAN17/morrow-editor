{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Morrow",
  "version": "0.3.0",
  "identifier": "app.morrow.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Morrow", "width": 1320, "height": 840, "minWidth": 720, "minHeight": 500, "dragDropEnabled": true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "fileAssociations": [{ "ext": ["txt", "md", "log", "py", "js", "ts", "json", "html", "css", "rs", "go", "java", "cpp", "c", "cs", "yaml", "yml", "toml", "xml", "sh", "ps1"], "name": "Text and source files", "description": "Open with Morrow", "role": "Editor" }],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  },
  "plugins": { "fs": { "requireLiteralLeadingDot": false }, "http": { "scopeRedirects": true } }
}
