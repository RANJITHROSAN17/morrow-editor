{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Only selected files and the local Ollama API are accessible.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "dialog:default",
    "fs:allow-read-file",
    "fs:allow-stat",
    { "identifier": "http:default", "allow": [{ "url": "http://127.0.0.1:11434/**" }] }
  ]
}
